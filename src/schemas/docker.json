{
  "name": "docker",
  "subcommands": [
    { "name": "ps", "options": [{ "name": "-a", "description": "stopped ones too" }] },
    { "name": "images" },
    { "name": "build",
      "options": [{ "name": "-t", "description": "tag the image" },
                  { "name": "--no-cache", "description": "build every layer again" }] },
    { "name": "run",
      "options": [{ "name": "-it", "description": "interactive, with a terminal" },
